{
  "redirects": [
    {
      "source": "/:path((?!\\.well-known).*)",
      "has": [{ "type": "host", "value": "cropvibe.com" }],
      "destination": "https://www.cropvibe.com/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/reel/:id",
      "destination": "https://cropvibe-api-production.up.railway.app/api/share/reel/:id"
    },
    {
      "source": "/profile/:id",
      "destination": "https://cropvibe-api-production.up.railway.app/api/share/profile/:id"
    },
    {
      "source": "/((?!\\.well-known).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
