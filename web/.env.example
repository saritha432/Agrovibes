# Production API (same as mobile EXPO_PUBLIC_API_BASE_URL)
VITE_API_BASE_URL=https://agrovibes.onrender.com/api

# Android App Links — set in Vercel (Build env), not needed for local Vite dev.
# Play Console → Setup → App integrity → App signing key certificate → SHA-256.
# Comma-separate upload + app signing keys if both are used.
# ANDROID_APP_LINK_SHA256=AA:BB:CC:...

# Local backend (needs PostgreSQL — see repo docker-compose.yml)
# VITE_API_BASE_URL=http://localhost:5000/api
