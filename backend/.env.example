# --- Server ---
PORT=5000
NODE_ENV=development

# Comma-separated web origins (Expo web, admin dashboards). Use your deployed Expo web URL and/or "*".
# Example: https://your-app.expo.app,http://localhost:8082
CORS_ORIGIN=http://localhost:8082,http://localhost:19006,https://www.cropvibe.com

# Public web origin for share-link HTML (/api/share/reel) and Open Graph URLs
# WEB_APP_ORIGIN=https://www.cropvibe.com

# --- Supabase PostgreSQL ---
# Project Settings → Database → Connection string (URI). Use the "Transaction" pooler for serverless hosts
# (Render/Railway) when recommended; append ?sslmode=require if not already present.
# Example:
# DATABASE_URL=postgresql://postgres.[ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agrovibes
# Set to true to refuse starting without DATABASE_URL (no pg-mem fallback).
# DATABASE_URL_REQUIRED=true

# --- Upstash Redis (HTTP cache) ---
# Redis tab → REST API → UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXX...

# --- AWS S3 (recommended for reels/posts/stories media) ---
# Create bucket + IAM user with s3:PutObject, s3:GetObject on bucket.
# Bucket policy: public read on agrovibes/* for mobile playback.
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=cropvibe-media
#
# CloudFront CDN (recommended for reels/posts playback — faster + cheaper egress):
# 1) S3 → create distribution → Origin: cropvibe-media.s3.ap-south-1.amazonaws.com
# 2) Origin access: Origin access control (OAC) — allow bucket GetObject to CloudFront
# 3) Default behavior: GET, HEAD, Query strings: None, Compress: On
# 4) After deploy, copy domain (e.g. d1234abcd.cloudfront.net) into ONE of:
# AWS_CLOUDFRONT_DOMAIN=d1234abcd.cloudfront.net
# AWS_S3_PUBLIC_BASE_URL=https://d1234abcd.cloudfront.net
# New uploads return CloudFront URLs; API rewrites old direct S3 URLs automatically.
#
# Set false if bucket uses a policy only (no per-object ACL):
# AWS_S3_PUBLIC_READ=false
#
# For browser/app playback (pick ONE approach):
# A) Bucket policy (recommended): public GetObject on arn:aws:s3:::YOUR_BUCKET/agrovibes/*
#    + turn OFF "Block all public access" on account + bucket.
# B) Object ACL: AWS_S3_PUBLIC_READ=true + Object Ownership "Bucket owner preferred"
#    + uncheck "Block public ACLs" on the bucket.

# --- Supabase Storage (legacy fallback if AWS S3 vars are not set) ---
# Project Settings → API → Project URL (https://xxxx.supabase.co — NOT /rest/v1 or database URL).
# Legacy tab → service_role key (eyJ...). Storage → public bucket "media".
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SUPABASE_STORAGE_BUCKET=media

# --- Support contact form (web /contact-support) ---
# Resend sends (1) support alert to info@cropvibe.com and (2) auto-reply to the user.
# Without RESEND_API_KEY, FormSubmit delivers to support inbox only (no user auto-reply).
# RESEND_API_KEY=re_xxx
# SUPPORT_CONTACT_TO=info@cropvibe.com
# SUPPORT_FROM_EMAIL=Cropvibe Support <no-reply@cropvibe.com>

# --- Auth ---
JWT_SECRET=change-me-in-production
OTP_HASH_SECRET=change-this-to-a-strong-random-secret

# Razorpay (https://dashboard.razorpay.com/app/keys) — optional; omit in dev for mock checkout
# RAZORPAY_KEY_ID=rzp_test_xxxx
# RAZORPAY_KEY_SECRET=xxxx

# OTP/Auth
# OTP provider: twilio | msg91
OTP_PROVIDER=msg91
# Set to true in production to disable dev OTP fallback.
OTP_STRICT_PROVIDER=false

# MSG91 (India OTP)
# MSG91_AUTH_KEY=xxxxxxxxxxxxxxxx
# MSG91_TEMPLATE_ID=xxxxxxxxxxxxxxxx
# Optional for some MSG91 OTP configurations:
# MSG91_SENDER_ID=AGRVIB
# Optional depending on your MSG91 setup
# MSG91_FLOW_ID=xxxxxxxxxxxxxxxx

# Twilio Verify
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- LiveKit (real-time live streaming) ---
# Required for /api/v1/live/token. Use LiveKit Cloud (free tier) or self-hosted LiveKit.
# Local dev example:
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret
# Production (Render) example:
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=your_api_key
# LIVEKIT_API_SECRET=your_api_secret
# Phone replay (when RESTORE WHEN SUPABASE PAID): point LiveKit egress at AWS S3:
# LIVEKIT_EGRESS_S3_ACCESS_KEY=<same as AWS_ACCESS_KEY_ID or dedicated IAM key>
# LIVEKIT_EGRESS_S3_SECRET=<same as AWS_SECRET_ACCESS_KEY>
# LIVEKIT_EGRESS_S3_BUCKET=agrovibes-media
# LIVEKIT_EGRESS_S3_REGION=ap-south-1
# LIVEKIT_EGRESS_S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Firebase Cloud Messaging (push notifications) ---
# Firebase Console → Project settings → Service accounts → Generate new private key.
# On Render: paste the full JSON as one line (no line breaks) into FIREBASE_SERVICE_ACCOUNT_JSON.
# Local dev: save the JSON file and set FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Mobile: download google-services.json (Android app com.cropvibe.app) into mobile/google-services.json

# --- Chat (Socket.IO) ---
# Real-time DMs use WebSocket on the same host as this API (path /socket.io).
# REST POST /v1/messages/thread/:peerUserId still persists to PostgreSQL; Socket.IO delivers live updates.
# FCM handles background push when the app is closed.
