# --- Server ---
PORT=5000
NODE_ENV=development

# Comma-separated web origins (Expo web, admin dashboards). Use your deployed Expo web URL and/or "*".
# Example: https://your-app.expo.app,http://localhost:8082
CORS_ORIGIN=http://localhost:8082,http://localhost:19006

# --- Supabase PostgreSQL ---
# Project Settings → Database → Connection string (URI). Use the "Transaction" pooler for serverless hosts
# (Render/Railway) when recommended; append ?sslmode=require if not already present.
# Example:
# DATABASE_URL=postgresql://postgres.[ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agrovibes
# Set to true to refuse starting without DATABASE_URL (no pg-mem fallback).
# DATABASE_URL_REQUIRED=true

# --- Upstash Redis (HTTP cache) ---
# Redis tab → REST API → UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXX...

# --- Supabase Storage (all media uploads) ---
# Project Settings → API → Project URL (https://xxxx.supabase.co — NOT /rest/v1 or database URL).
# Legacy tab → service_role key (eyJ...). Storage → public bucket "media".
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SUPABASE_STORAGE_BUCKET=media

# --- Auth ---
JWT_SECRET=change-me-in-production
OTP_HASH_SECRET=change-this-to-a-strong-random-secret

# Razorpay (https://dashboard.razorpay.com/app/keys) — optional; omit in dev for mock checkout
# RAZORPAY_KEY_ID=rzp_test_xxxx
# RAZORPAY_KEY_SECRET=xxxx

# OTP/Auth
# OTP provider: twilio | msg91
OTP_PROVIDER=msg91
# Set to true in production to disable dev OTP fallback.
OTP_STRICT_PROVIDER=false

# MSG91 (India OTP)
# MSG91_AUTH_KEY=xxxxxxxxxxxxxxxx
# MSG91_TEMPLATE_ID=xxxxxxxxxxxxxxxx
# Optional for some MSG91 OTP configurations:
# MSG91_SENDER_ID=AGRVIB
# Optional depending on your MSG91 setup
# MSG91_FLOW_ID=xxxxxxxxxxxxxxxx

# Twilio Verify
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- LiveKit (real-time live streaming) ---
# Required for /api/v1/live/token. Use LiveKit Cloud (free tier) or self-hosted LiveKit.
# Local dev example:
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret
# Production (Render) example:
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=your_api_key
# LIVEKIT_API_SECRET=your_api_secret
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
