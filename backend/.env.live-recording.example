# Live replay → AWS S3 (same bucket as reels/posts). CloudFront optional via AWS_CLOUDFRONT_DOMAIN.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=cropvibe-media
# AWS_CLOUDFRONT_DOMAIN=d1234abcd.cloudfront.net

LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

LIVEKIT_EGRESS_S3_ACCESS_KEY=<same as AWS_ACCESS_KEY_ID>
LIVEKIT_EGRESS_S3_SECRET=<same as AWS_SECRET_ACCESS_KEY>
LIVEKIT_EGRESS_S3_BUCKET=cropvibe-media
LIVEKIT_EGRESS_S3_REGION=ap-south-1
LIVEKIT_EGRESS_S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
