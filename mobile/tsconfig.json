{
  "include": ["**/*.ts", "**/*.tsx", "svg.d.ts"],
  "exclude": ["node_modules", "eas-inspect-out"],
  "compilerOptions": {
    "target": "es2017",
    "module": "esnext",
    "lib": [
      "es2017"
    ],
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "extends": "expo/tsconfig.base"
}
