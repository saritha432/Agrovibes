{
  "expo": {
    "name": "Cropvibe",
    "slug": "agrovibes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-adaptive-foreground.png",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#262626"
    },
    "assetBundlePatterns": [
      "./assets/**"
    ],
    "scheme": "agrovibes",
    "android": {
      "package": "com.agrovibes.app",
      "label": "Cropvibe",
      "statusBar": {
        "backgroundColor": "#262626",
        "barStyle": "light-content",
        "translucent": false
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-adaptive-foreground.png",
        "backgroundColor": "#262626"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.agrovibes.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Cropvibe uses your camera to record reels, stories, and posts.",
        "NSMicrophoneUsageDescription": "Cropvibe uses your microphone to record audio for reels and stories.",
        "NSPhotoLibraryUsageDescription": "Cropvibe accesses your photo library so you can upload images and videos.",
        "NSPhotoLibraryAddUsageDescription": "Cropvibe saves edited photos to your library when you ask it to.",
        "NSLocationWhenInUseUsageDescription": "Cropvibe can tag posts with your district when you add a location."
      }
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "owner": "mounika-m",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f6754164-ad7d-4832-89d0-36119b56026b"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Cropvibe uses your camera to record reels, stories, and posts.",
          "microphonePermission": "Cropvibe uses your microphone to record audio for reels and stories.",
          "recordAudioAndroid": true
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "f6754164-ad7d-4832-89d0-36119b56026b"
      }
    }
  }
}
