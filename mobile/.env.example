# Public API base (no secrets here). Trailing slash is stripped at runtime.
# Point this at your Railway backend URL + /api
EXPO_PUBLIC_API_BASE_URL=https://cropvibe-api-production.up.railway.app/api

# Optional: canonical web app URL for share links (reels, etc.) on native builds.
# On Expo web, the current browser origin is used when this is unset.
# EXPO_PUBLIC_WEB_BASE_URL=https://www.cropvibe.com

# Local dev: use http://localhost:5000/api when the Node backend runs on port 5000.

# EAS Build: set the same variable for each profile so release builds hit production:
#   eas env:create --name EXPO_PUBLIC_API_BASE_URL --value https://cropvibe-api-production.up.railway.app/api --environment production
