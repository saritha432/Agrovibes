{
  "name": "cropvibe-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "engines": {
    "node": "20.x"
  },
  "expo": {
    "install": {
      "exclude": ["react-native-screens"]
    }
  },
  "scripts": {
    "start": "expo start --port 8082",
    "start:clean": "expo start --port 8082 --clear",
    "start:tunnel": "expo start --tunnel --port 8082",
    "start:lan": "expo start --lan --port 8082",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --port 8082",
    "web:8083": "expo start --web --port 8083",
    "build:web": "node ./node_modules/expo/bin/cli export --platform web",
    "vercel-build": "node ./node_modules/expo/bin/cli export --platform web",
    "eas-build-pre-install": "node scripts/eas-build-pre-install.js",
    "eas-build-post-install": "node scripts/eas-build-post-install.js",
    "build:android:preview": "node scripts/eas.js build --platform android --profile preview",
    "build:android:dev": "node scripts/eas.js build --platform android --profile development",
    "build:ios:dev": "node scripts/eas.js build --platform ios --profile development",
    "prebuild:android": "node scripts/prebuild-android-release.js",
    "prebuild:android:dev": "npx expo prebuild --platform android --clean",
    "build:android:local": "cd android && gradlew.bat assembleRelease",
    "build:android:local:apk": "npm run prebuild:android && npm run build:android:local",
    "build:android:prod": "node scripts/eas.js build --platform android --profile production",
    "build:ios:preview": "node scripts/eas.js build --platform ios --profile preview",
    "build:ios:prod": "node scripts/eas.js build --platform ios --profile production",
    "build:all:preview": "node scripts/eas.js build --platform all --profile preview",
    "build:all:prod": "node scripts/eas.js build --platform all --profile production",
    "doctor": "npx expo-doctor",
    "generate:adaptive-icon": "node scripts/generate-adaptive-icon.cjs",
    "preview:adaptive-icon": "node scripts/preview-adaptive-icon.cjs",
    "postinstall": "node scripts/patch-expo-device-xcode26.js && patch-package"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^9.0.0",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/metro-runtime": "~3.2.3",
    "@livekit/react-native": "^2.10.3",
    "@livekit/react-native-expo-plugin": "^1.0.2",
    "@livekit/react-native-webrtc": "^144.0.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-firebase/analytics": "^21.14.0",
    "@react-native-firebase/app": "^21.14.0",
    "@react-native-firebase/crashlytics": "^21.14.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "expo": "^51.0.28",
    "expo-av": "~14.0.7",
    "expo-build-properties": "^0.12.5",
    "expo-camera": "~15.0.16",
    "expo-clipboard": "~6.0.3",
    "expo-constants": "~16.0.2",
    "expo-device": "~6.0.2",
    "expo-file-system": "~17.0.1",
    "expo-font": "~12.0.10",
    "expo-image-manipulator": "~12.0.5",
    "expo-image-picker": "~15.1.0",
    "expo-linear-gradient": "~13.0.2",
    "expo-media-library": "~16.0.5",
    "expo-notifications": "~0.28.19",
    "expo-updates": "~0.25.28",
    "expo-video-thumbnails": "~8.0.0",
    "fast-text-encoding": "^1.0.6",
    "i18next": "^26.2.0",
    "livekit-client": "^2.19.0",
    "metro": "0.80.12",
    "metro-config": "0.80.12",
    "metro-core": "0.80.12",
    "nativewind": "^4.2.3",
    "patch-package": "^8.0.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-i18next": "^17.0.8",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.37.0",
    "react-native-svg": "15.2.0",
    "react-native-view-shot": "3.8.0",
    "react-native-web": "~0.19.10",
    "react-native-webview": "13.8.6",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@types/react": "~18.2.79",
    "expo-dev-client": "~4.0.29",
    "react-native-svg-transformer": "^1.5.3",
    "sharp": "^0.33.5",
    "typescript": "~5.3.3"
  }
}
